# Claude Code local config — never commit
.claude/

# Plugin outputs (generated during testing)
plugins/*/skills/*/outputs/*
!plugins/*/skills/*/outputs/.gitkeep

# Local engagement state & config — NEVER commit (holds scope, sessions, live tokens/secrets)
/outputs/
.pentest-*.json
.codeaudit-*.json

# Playwright MCP scratch output — browser console/network logs from live targets (leaks real client hostnames)
/.playwright-mcp/

# Captured traffic — HARs hold Authorization/Cookie headers + response bodies (live secrets); the observed
# corpus/raw lists hold real client hostnames+paths. NEVER commit. (har-import strips header VALUES for the
# inventory, but the raw .har is unscrubbed.)
*.har
**/har/
observed-requests.jsonl
raw-traffic.jsonl
playwright-mcp-session.har

# Local OAST test lab — deliberately vulnerable, never commit or deploy
/oast-lab/

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Node deps (stealth probe — installed on first use)
node_modules/
